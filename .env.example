# Copy to `.env` (ignored by Git) and fill in from the development projects
# only (docs/working/BACKEND_SETUP_0.5.0.md). Never a production value.

# Supabase development project → Project Settings → API.
SUPABASE_URL=
# The publishable key (sb_publishable_…); it is meant to be public.
SUPABASE_ANON_KEY=

# The connection string of the dedicated `powersync_role` (setup step 3),
# never the `postgres` user.
PS_DATABASE_URI=

# PowerSync Cloud: a personal access token for the CLI, and the project id.
PS_ADMIN_TOKEN=
POWERSYNC_PROJECT_ID=
# Filled by the agent after `powersync link cloud --create`.
POWERSYNC_URL=

# Two synthetic test accounts (Supabase → Authentication → Users, "Auto
# Confirm User"), for tests/e2e/b2-backend.spec.ts only.
TEST_USER_1_EMAIL=
TEST_USER_1_PASSWORD=
TEST_USER_2_EMAIL=
TEST_USER_2_PASSWORD=
