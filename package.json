{
  "name": "cvc-helper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:domain": "node --import tsx scripts/check-domain.ts",
    "check:repository": "node scripts/check-repository.mjs",
    "verify:quick": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "verify:domain": "npm run check:repository && npm run check:domain",
    "verify:e2e": "playwright test",
    "verify": "npm run verify:quick && npm run verify:domain && npm run build",
    "verify:all": "npm run verify && npm run verify:e2e",
    "milestone:start": "node scripts/milestone.mjs start",
    "milestone:check": "node scripts/milestone.mjs check",
    "milestone:complete": "node scripts/milestone.mjs complete",
    "milestone:self-test": "node scripts/milestone.mjs self-test",
    "evidence:m0": "node scripts/record-verification.mjs M0",
    "evidence:m1": "node scripts/record-verification.mjs M1",
    "evidence:m2": "node scripts/record-verification.mjs M2",
    "evidence:m3": "node scripts/record-verification.mjs M3",
    "evidence:m4": "node scripts/record-verification.mjs M4",
    "evidence:g1": "node scripts/record-verification.mjs G1",
    "evidence:m5": "node scripts/record-verification.mjs M5",
    "evidence:m6": "node scripts/record-verification.mjs M6",
    "evidence:g2": "node scripts/record-verification.mjs G2",
    "evidence:m7": "node scripts/record-verification.mjs M7",
    "evidence:g3": "node scripts/record-verification.mjs G3",
    "evidence:m8": "node scripts/record-verification.mjs M8",
    "evidence:m9": "node scripts/record-verification.mjs M9",
    "evidence:m10": "node scripts/record-verification.mjs M10",
    "evidence:m11": "node scripts/record-verification.mjs M11",
    "evidence:g4": "node scripts/record-verification.mjs G4"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@huggingface/transformers": "^4.2.0",
    "@powersync/web": "^2.2.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.4"
  }
}
